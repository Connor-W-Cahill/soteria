# Browser-facing API base URL. Leave blank in local development to use Vite's proxy.
VITE_API_URL=

# Server settings (names only; never commit secret values).
PORT=3000
LOG_LEVEL=info
# SQL Server connection URL. Names only; never commit a real value.
#   local  (docker compose up sql):
#     sqlserver://sa:Soteria_local_dev_1@localhost:1433/soteria?encrypt=false
#   Azure SQL:
#     sqlserver://<user>:<password>@<server>.database.windows.net:1433/<db>?encrypt=true
DATABASE_URL=

# Password for the local SQL Server container only. Never used in Azure.
MSSQL_SA_PASSWORD=

# Browser origin allowed to call the API. Set by infra/deploy.sh in Azure to the
# Static Web App hostname. Empty in development means the Vite dev server is
# allowed; empty in production means no cross-origin browser call is allowed.
WEB_ORIGIN=

# --- Auth (US-14) ---
# Google OAuth client id. Also the required `aud` of every ID token the API
# accepts, so a token minted for another application is rejected. Not a secret,
# but it must match the value the browser uses.
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# HMAC key for Soteria's own session cookies. At least 32 bytes; generate with
# `openssl rand -base64 48`. Rotating it signs everyone out. Never commit a value.
SESSION_SECRET=

# Set to 1 to force the `Secure` cookie attribute outside production, e.g. when
# testing behind an HTTPS tunnel. Production sets it from NODE_ENV.
FORCE_SECURE_COOKIES=
