{
  "name": "soteria",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "client",
    "server",
    "shared"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -n client,server -c auto \"npm run dev -w @soteria/client\" \"npm run dev -w @soteria/server\"",
    "lint": "eslint . && prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "format": "prettier --write .",
    "db:migrate": "npm run db:migrate -w @soteria/server",
    "db:rollback": "npm run db:rollback -w @soteria/server",
    "db:seed": "npm run db:seed -w @soteria/server",
    "db:ensure": "npm run db:ensure -w @soteria/server",
    "db:status": "npm run db:status -w @soteria/server"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.35.0",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0"
  }
}
