{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://soteria.local/schema/products.schema.json",
  "title": "Soteria product catalog",
  "description": "Curated catalog of consumer software with the CPE identifiers and version-lookup help used by the CVE matcher (INF-07).",
  "type": "object",
  "additionalProperties": false,
  "required": ["products"],
  "properties": {
    "$schema": { "type": "string" },
    "products": {
      "type": "array",
      "minItems": 18,
      "maxItems": 24,
      "items": { "$ref": "#/$defs/product" }
    }
  },
  "$defs": {
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "vendor",
        "category",
        "cpeVendor",
        "cpeProduct",
        "versionScheme",
        "versionHelp",
        "vendorAdvisoryUrl"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "maxLength": 80,
          "description": "Stable kebab-case identifier used as the products table primary key."
        },
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "vendor": { "type": "string", "minLength": 1, "maxLength": 200 },
        "category": {
          "type": "string",
          "enum": ["operating-system", "browser", "application"]
        },
        "cpeVendor": {
          "type": "string",
          "pattern": "^[a-z0-9._~%\\-\\\\+]+$",
          "maxLength": 120,
          "description": "The vendor field of the NVD CPE 2.3 name, verified against the NVD CPE dictionary."
        },
        "cpeProduct": {
          "type": "string",
          "pattern": "^[a-z0-9._~%\\-\\\\+]+$",
          "maxLength": 120,
          "description": "The product field of the NVD CPE 2.3 name, verified against the NVD CPE dictionary."
        },
        "versionScheme": {
          "type": "string",
          "enum": ["semver", "build", "marketing"]
        },
        "versionHelp": {
          "type": "object",
          "additionalProperties": false,
          "required": ["platform", "steps"],
          "properties": {
            "platform": { "type": "string", "minLength": 1, "maxLength": 80 },
            "steps": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1, "maxLength": 400 }
            }
          }
        },
        "vendorAdvisoryUrl": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://",
          "maxLength": 500
        }
      }
    }
  }
}
